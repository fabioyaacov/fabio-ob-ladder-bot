// This Pine Script code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// OB Ladder Strategy with Webhook Alerts for Bybit Testnet
// Based on 'Volumized Order Blocks | Flux Charts' © fluxchart
// Enhanced with: Mid-range line between nearest OBs, individual TPs per entry
//   (positioned in premium/discount area), re-entry control, webhook dedup
//
// Strategy logic:
//   1. Find nearest Bull OB (support) and Bear OB (resistance) to current price
//   2. Draw mid-range line between them (50% of the gap)
//   3. Place 4 Long entries inside Bull OB, 4 Short entries inside Bear OB
//   4. Each Long entry has TP1/TP2/TP3 in the premium area (above mid-range)
//   5. Each Short entry has TP1/TP2/TP3 in the discount area (below mid-range)
//   6. Re-entry control: one entry per OB per direction, no duplicates
//   7. Webhook alerts fire once per entry (deduplicated)

//@version=6
const bool DEBUG = false
const int maxBoxesCount = 500
const int maxLinesCount = 500
const int maxLabelsCount = 500
const float overlapThresholdPercentage = 0
const int maxDistanceToLastBar = 1750
const int maxOrderBlocks = 30

strategy(title = 'Fabio OB Ladder Strategy + Webhook | Bybit Testnet', shorttitle = 'Fabio OB Ladder', overlay = true, initial_capital = 1000, default_qty_type = strategy.cash, default_qty_value = 1000, commission_type = strategy.commission.percent, commission_value = 0.06, max_boxes_count = maxBoxesCount, max_labels_count = maxLabelsCount, max_lines_count = maxLinesCount, max_bars_back = 5000)

// ============================================================================
// INPUTS - General Configuration
// ============================================================================
showInvalidated = input.bool(true, "Show Historic Zones", group = "General Configuration", display = display.none)
OBsEnabled = true
orderBlockVolumetricInfo = input.bool(true, "Volumetric Info", group = "General Configuration", inline="EV", display = display.none)
obEndMethod = input.string("Wick", "Zone Invalidation", options = ["Wick", "Close"],  group = "General Configuration", display = display.none)
combineOBs = true
maxATRMult = 3.5
swingLength = input.int(10, 'Swing Length', minval = 3, tooltip="Swing length for finding order block formations.", group = "General Configuration", display = display.none)
zoneCount = input.string("Low", 'Zone Count', options = ["High", "Medium", "Low", "One"], tooltip = "Number of Order Block Zones to render.", group = "General Configuration", display = display.none)
bullOrderBlockColor = input(#08998180, 'Bullish', inline = 'obColor', group = 'General Configuration', display = display.none)
bearOrderBlockColor = input(#f2364680, 'Bearish', inline = 'obColor', group = 'General Configuration', display = display.none)

bullishOrderBlocks = zoneCount == "One" ? 1 : zoneCount == "Low" ? 3 : zoneCount == "Medium" ? 5 : 10
bearishOrderBlocks = zoneCount == "One" ? 1 : zoneCount == "Low" ? 3 : zoneCount == "Medium" ? 5 : 10

timeframe1Enabled = true
timeframe1 = ""

// ============================================================================
// INPUTS - Top/Bottom + 50% Line Configuration (inside each OB)
// ============================================================================
swingTopBottomLength = input.int(20, 'Swing Top/Bottom Length', minval = 5, tooltip="Length for detecting well-defined tops and bottoms.", group = "Top/Bottom & 50% Line")
show50Line = input.bool(true, "Show 50% Line (inside OB)", group = "Top/Bottom & 50% Line")
line50Color = input.color(#ff980080, "50% Line Color", group = "Top/Bottom & 50% Line")
line50Width = input.int(2, "50% Line Width", minval = 1, maxval = 5, group = "Top/Bottom & 50% Line")
line50Style = input.string("Dashed", "50% Line Style", options = ["Solid", "Dashed", "Dotted"], group = "Top/Bottom & 50% Line")

// ============================================================================
// INPUTS - Mid-Range Line (between nearest Bull OB and Bear OB)
// ============================================================================
showMidRange = input.bool(true, "Show Mid-Range Line", tooltip="Draws a line at 50% between the nearest support OB and resistance OB.", group = "Mid-Range")
midRangeColor = input.color(#ffeb3b, "Mid-Range Color", group = "Mid-Range")
midRangeWidth = input.int(2, "Mid-Range Width", minval = 1, maxval = 5, group = "Mid-Range")
midRangeStyle = input.string("Solid", "Mid-Range Style", options = ["Solid", "Dashed", "Dotted"], group = "Mid-Range")

// ============================================================================
// INPUTS - Value Zones Configuration
// ============================================================================
showValueZones = input.bool(true, "Show Value Zones", group = "Value Zones")
buyZoneColor = input.color(#08998120, "Buy Zone Color (Discount)", group = "Value Zones")
sellZoneColor = input.color(#f2364620, "Sell Zone Color (Premium)", group = "Value Zones")
valueZoneTransp = input.int(80, "Value Zone Transparency", minval = 0, maxval = 100, group = "Value Zones")

// ============================================================================
// INPUTS - Ladder Orders Configuration
// ============================================================================
showLadder = input.bool(true, "Show Ladder Orders", group = "Ladder Orders Configuration")
accountBalance = input.float(1000.0, "Account Balance (USDT)", minval = 100.0, group = "Ladder Orders Configuration")
riskPerTradePct = input.float(1.0, "Risk per Trade (%)", minval = 0.1, maxval = 10.0, step = 0.1, group = "Ladder Orders Configuration")
longLadderColor = input.color(#089981, "Long Ladder Color", group = "Ladder Orders Configuration")
shortLadderColor = input.color(#f23646, "Short Ladder Color", group = "Ladder Orders Configuration")
stopLossColor = input.color(#f2364680, "Stop Loss Color", group = "Ladder Orders Configuration")
takeProfitColor = input.color(#08998180, "Take Profit Color", group = "Ladder Orders Configuration")
ladderLabelColor = input.color(#ffffff, "Ladder Label Color", group = "Ladder Orders Configuration")

// ============================================================================
// INPUTS - Strategy/Execution Configuration
// ============================================================================
enableWebhook = input.bool(true, "Enable Webhook Alerts", tooltip="Send webhook alerts when price touches ladder entries.", group = "Strategy Configuration")
enableStrategyOrders = input.bool(true, "Enable Strategy Simulation", tooltip="Also simulate orders in TradingView paper trading.", group = "Strategy Configuration")
tickerSymbol = input.string("BTCUSDT", "Trading Symbol", group = "Strategy Configuration")

// ============================================================================
// INPUTS - Style
// ============================================================================
textColor = input.color(#ffffff80, "Text Color", group = "Style")
extendZonesBy = 15
extendZonesDynamic = true
volumeBarsPlace = "Left"
mirrorVolumeBars = true
volumeBarsLeftSide = (volumeBarsPlace == "Left")
extendZonesByTime = extendZonesBy * timeframe.in_seconds(timeframe.period) * 1000

atr = ta.atr(10)

// ============================================================================
// TYPES - Order Block Info
// ============================================================================
type orderBlockInfo
    float top
    float bottom
    float obVolume
    string obType
    int startTime
    float bbVolume
    float obLowVolume
    float obHighVolume
    bool breaker
    int breakTime
    string timeframeStr
    bool disabled = false
    string combinedTimeframesStr = na
    bool combined = false
    float swing50 = na
    float swingHigh = na
    float swingLow = na

type orderBlock
    orderBlockInfo info
    bool isRendered = false
    box orderBox = na
    box breakerBox = na
    line orderBoxLineTop = na
    line orderBoxLineBottom = na
    line breakerBoxLineTop = na
    line breakerBoxLineBottom = na
    box orderBoxText = na
    box orderBoxPositive = na
    box orderBoxNegative = na
    line orderSeperator = na
    line orderTextSeperator = na
    line[] ladderLines = na
    label[] ladderLabels = na
    line[] slLines = na
    line[] tpLines = na
    label[] slLabels = na
    label[] tpLabels = na
    label avgPriceLabel = na
    line avgPriceLine = na
    line line50 = na
    box valueZone = na

createOrderBlock(orderBlockInfo orderBlockInfoF) =>
    orderBlock newOrderBlock = orderBlock.new(orderBlockInfoF)
    newOrderBlock

safeDeleteOrderBlock(orderBlock orderBlockF) =>
    orderBlockF.isRendered := false
    box.delete(orderBlockF.orderBox)
    box.delete(orderBlockF.breakerBox)
    box.delete(orderBlockF.orderBoxText)
    box.delete(orderBlockF.orderBoxPositive)
    box.delete(orderBlockF.orderBoxNegative)
    line.delete(orderBlockF.orderBoxLineTop)
    line.delete(orderBlockF.orderBoxLineBottom)
    line.delete(orderBlockF.breakerBoxLineTop)
    line.delete(orderBlockF.breakerBoxLineBottom)
    line.delete(orderBlockF.orderSeperator)
    line.delete(orderBlockF.orderTextSeperator)
    if not na(orderBlockF.ladderLines)
        for i = 0 to orderBlockF.ladderLines.size() - 1
            line.delete(orderBlockF.ladderLines.get(i))
        orderBlockF.ladderLines.clear()
    if not na(orderBlockF.ladderLabels)
        for i = 0 to orderBlockF.ladderLabels.size() - 1
            label.delete(orderBlockF.ladderLabels.get(i))
        orderBlockF.ladderLabels.clear()
    if not na(orderBlockF.slLines)
        for i = 0 to orderBlockF.slLines.size() - 1
            line.delete(orderBlockF.slLines.get(i))
        orderBlockF.slLines.clear()
    if not na(orderBlockF.tpLines)
        for i = 0 to orderBlockF.tpLines.size() - 1
            line.delete(orderBlockF.tpLines.get(i))
        orderBlockF.tpLines.clear()
    if not na(orderBlockF.slLabels)
        for i = 0 to orderBlockF.slLabels.size() - 1
            label.delete(orderBlockF.slLabels.get(i))
        orderBlockF.slLabels.clear()
    if not na(orderBlockF.tpLabels)
        for i = 0 to orderBlockF.tpLabels.size() - 1
            label.delete(orderBlockF.tpLabels.get(i))
        orderBlockF.tpLabels.clear()
    label.delete(orderBlockF.avgPriceLabel)
    line.delete(orderBlockF.avgPriceLine)
    line.delete(orderBlockF.line50)
    box.delete(orderBlockF.valueZone)

type timeframeInfo
    int index = na
    string timeframeStr = na
    bool isEnabled = false
    orderBlockInfo[] bullishOrderBlocksList = na
    orderBlockInfo[] bearishOrderBlocksList = na

newTimeframeInfo(index, timeframeStr, isEnabled) =>
    newTFInfo = timeframeInfo.new()
    newTFInfo.index := index
    newTFInfo.isEnabled := isEnabled
    newTFInfo.timeframeStr := timeframeStr
    newTFInfo

type obSwing
    int x = na
    float y = na
    float swingVolume = na
    bool crossed = false

// ============================================================================
// GLOBALS
// ============================================================================
var timeframeInfo[] timeframeInfos = array.from(newTimeframeInfo(1, timeframe1, timeframe1Enabled))
var bullishOrderBlocksList = array.new<orderBlockInfo>(0)
var bearishOrderBlocksList = array.new<orderBlockInfo>(0)
var allOrderBlocksList = array.new<orderBlock>(0)

// Re-entry control: track which entries have already been triggered
var string[] firedEntries = array.new<string>(0)
var int lastBullOBStartTime = na
var int lastBearOBStartTime = na

// Mid-range line tracking
var line midRangeLine = na
var label midRangeLabel = na
var float currentMidRange = na

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================
moveLine(_line, _x, _y, _x2) =>
    line.set_xy1(_line, _x, _y)
    line.set_xy2(_line, _x2, _y)

moveBox(_box, _topLeftX, _topLeftY, _bottomRightX, _bottomRightY) =>
    box.set_lefttop(_box, _topLeftX, _topLeftY)
    box.set_rightbottom(_box, _bottomRightX, _bottomRightY)

isTimeframeLower(tf1, tf2) =>
    timeframe.in_seconds(tf1) < timeframe.in_seconds(tf2)

formatTimeframeString(formatTimeframe) =>
    timeframeF = formatTimeframe == "" ? timeframe.period : formatTimeframe
    if str.contains(timeframeF, "D") or str.contains(timeframeF, "W") or str.contains(timeframeF, "S") or str.contains(timeframeF, "M")
        timeframeF
    else
        seconds = timeframe.in_seconds(timeframeF)
        if seconds >= 3600
            hourCount = int(seconds / 3600)
            str.tostring(hourCount) + " Hour" + (hourCount > 1 ? "s" : "")
        else
            timeframeF + " Min"

colorWithTransparency(colorF, transparencyX) =>
    color.new(colorF, color.t(colorF) * transparencyX)

lineStyleFromString(styleStr) =>
    styleStr == "Solid" ? line.style_solid : styleStr == "Dashed" ? line.style_dashed : line.style_dotted

// Check if an entry ID has already been fired (dedup)
hasFired(string entryId, string[] firedList) =>
    bool found = false
    if array.size(firedList) > 0
        for i = 0 to array.size(firedList) - 1
            if array.get(firedList, i) == entryId
                found := true
                break
    found

// Clear fired entries for a direction when a new OB is detected
clearFiredByDirection(string direction, string[] firedList) =>
    string[] remaining = array.new<string>(0)
    if array.size(firedList) > 0
        for i = 0 to array.size(firedList) - 1
            string id = array.get(firedList, i)
            if not str.startswith(id, direction)
                array.push(remaining, id)
    array.clear(firedList)
    if array.size(remaining) > 0
        for i = 0 to array.size(remaining) - 1
            array.push(firedList, array.get(remaining, i))

// ============================================================================
// SWING TOP/BOTTOM DETECTION
// ============================================================================
findSwingTopBottom(len) =>
    var float lastSwingHigh = na
    var float lastSwingLow = na
    var int lastSwingHighBar = na
    var int lastSwingLowBar = na

    ph = ta.pivothigh(high, len, len)
    pl = ta.pivotlow(low, len, len)

    if not na(ph)
        lastSwingHigh := ph
        lastSwingHighBar := bar_index[len]
    if not na(pl)
        lastSwingLow := pl
        lastSwingLowBar := bar_index[len]

    [lastSwingHigh, lastSwingLow, lastSwingHighBar, lastSwingLowBar]

// ============================================================================
// BOX CREATION
// ============================================================================
createOBBox(boxColor, transparencyX = 1.0, xlocType = xloc.bar_time) =>
    box.new(na, na, na, na, text_size = size.normal, xloc = xlocType, extend = extend.none, bgcolor = colorWithTransparency(boxColor, transparencyX), text_color = textColor, text_halign = text.align_center, border_color = #00000000)

// ============================================================================
// SEND WEBHOOK ALERT (with individual TPs per entry)
// ============================================================================
sendWebhookAlert(string action, string direction, float price, float size, float sl, float tp1, float tp2, float tp3, string entryId) =>
    if enableWebhook
        string json = '{"action":"' + action + '","symbol":"' + tickerSymbol + '","direction":"' + direction + '","price":' + str.tostring(price, format.mintick) + ',"size":' + str.tostring(size, "#.####") + ',"sl":' + str.tostring(sl, format.mintick) + ',"tp1":' + str.tostring(tp1, format.mintick) + ',"tp2":' + str.tostring(tp2, format.mintick) + ',"tp3":' + str.tostring(tp3, format.mintick) + ',"entry_id":"' + entryId + '","timestamp":' + str.tostring(time) + '}'
        alert(json, alert.freq_once_per_bar_close)

// ============================================================================
// LADDER ORDERS VISUALIZATION + STRATEGY ENTRY + WEBHOOK
// ---------------------------------------------------------------------------
// Key changes from original:
//   - TPs are calculated PER ENTRY (not from avgEntry)
//   - Long TPs are placed in premium area (between mid-range and Bear OB)
//   - Short TPs are placed in discount area (between mid-range and Bull OB)
//   - Re-entry control: each entry fires only once per OB cycle
//   - Webhook dedup: alert fires once per entry
// ============================================================================
renderLadderForOB(orderBlock ob, bool isNearest, float midRangePrice,	float oppositeOBTop, float oppositeOBBottom) =>
    info = ob.info
    float obTop = info.top
    float obBottom = info.bottom
    float obRange = math.abs(obTop - obBottom)

    bool canRender = obRange > 0 and not info.breaker
    bool priceNearOB = math.abs(close - (obTop + obBottom) / 2.0) <= obRange * 2.0

    if canRender and (isNearest or priceNearOB)
        string direction = info.obType == "Bull" ? "Long" : "Short"

        int numEntries = 4
        float spacing = obRange / (numEntries + 1)

        float[] entryPrices = array.new<float>(0)
        if direction == "Long"
            float startPrice = obBottom
            for i = 1 to numEntries
                float entryPrice = startPrice + (spacing * i)
                if entryPrice < obTop
                    array.push(entryPrices, entryPrice)
        else
            float startPrice = obTop
            for i = 1 to numEntries
                float entryPrice = startPrice - (spacing * i)
                if entryPrice > obBottom
                    array.push(entryPrices, entryPrice)

        int actualEntries = array.size(entryPrices)

        if actualEntries > 0
            // Average entry price (for display only)
            float sumEntries = 0.0
            for i = 0 to actualEntries - 1
                sumEntries += array.get(entryPrices, i)
            float avgEntry = sumEntries / actualEntries

            // Risk and position sizing
            float riskAmount = accountBalance * riskPerTradePct / 100.0
            float stopLoss = direction == "Long" ? obBottom * 0.998 : obTop * 1.002

            float positionSize = riskAmount / (math.abs(avgEntry - stopLoss) * actualEntries)

            // TP placement zone:
            //   Long: TPs go above mid-range toward Bear OB (premium area)
            //   Short: TPs go below mid-range toward Bull OB (discount area)
            // We partition the space between mid-range and opposite OB into 3 zones
            float tpZoneStart = midRangePrice
            float tpZoneEnd = direction == "Long" ? oppositeOBBottom : oppositeOBTop
            // Validate opposite OB:
            //   Long: tpZoneEnd (Bear OB bottom) must be ABOVE tpZoneStart (mid-range) => tpZoneEnd > tpZoneStart
            //   Short: tpZoneEnd (Bull OB top) must be BELOW tpZoneStart (mid-range) => tpZoneEnd < tpZoneStart
            bool hasValidOpposite = not na(oppositeOBBottom) and not na(oppositeOBTop)
            if direction == "Long"
                hasValidOpposite := hasValidOpposite and tpZoneEnd > tpZoneStart
            else
                hasValidOpposite := hasValidOpposite and tpZoneEnd < tpZoneStart

            int zoneSize = int(extendZonesDynamic ? na(info.breakTime) ? extendZonesByTime : (info.breakTime - info.startTime) : extendZonesByTime)
            int endX = int(na(info.breakTime) ? (time + 1) : info.breakTime)
            int ladderStartX = int(na(info.breakTime) ? (time + 1) - zoneSize * 0.4 : info.startTime + int(zoneSize * 0.6))
            int ladderEndX = int(na(info.breakTime) ? (time + 1) : info.breakTime)

            ob.ladderLines := array.new<line>(0)
            ob.ladderLabels := array.new<label>(0)
            ob.slLines := array.new<line>(0)
            ob.tpLines := array.new<line>(0)
            ob.slLabels := array.new<label>(0)
            ob.tpLabels := array.new<label>(0)

            color ladderColor = direction == "Long" ? longLadderColor : shortLadderColor
            color entryLineColor = color.new(#ffeb3b, 0)

            // Draw entries + strategy execution + webhook (with per-entry TPs)
            for i = 0 to actualEntries - 1
                float entryPrice = array.get(entryPrices, i)
                bool isPriced = direction == "Long" ? close <= entryPrice : close >= entryPrice
                int lineWidth = isPriced ? 2 : 1
                line entryLine = line.new(ladderStartX, entryPrice, ladderEndX, entryPrice, xloc = xloc.bar_time, color = entryLineColor, style = line.style_solid, width = lineWidth)
                array.push(ob.ladderLines, entryLine)

                string entryId = direction + "_" + str.tostring(i + 1)
                string statusText = isPriced ? " [ACTIVE]" : ""
                string entryText = "Entry " + str.tostring(i + 1) + statusText + "\n" + str.tostring(entryPrice, format.mintick) + "\n" + str.tostring(positionSize, "#.###") + " units"
                label entryLabel = label.new(ladderEndX, entryPrice, entryText, xloc = xloc.bar_time, color = color.new(entryLineColor, 70), textcolor = ladderLabelColor, style = label.style_label_left, size = size.tiny)
                array.push(ob.ladderLabels, entryLabel)

                // --- Calculate individual TPs for THIS entry ---
                float tp1 = na
                float tp2 = na
                float tp3 = na

                if hasValidOpposite
                    // Place TPs in the premium/discount zone between mid-range and opposite OB
                    // Partition into 3 equal sections
                    float zoneRange = math.abs(tpZoneEnd - tpZoneStart)
                    float tp1Dist = zoneRange * 0.25
                    float tp2Dist = zoneRange * 0.50
                    float tp3Dist = zoneRange * 0.75

                    if direction == "Long"
                        tp1 := tpZoneStart + tp1Dist
                        tp2 := tpZoneStart + tp2Dist
                        tp3 := tpZoneStart + tp3Dist
                        // Clamp: TP3 should not exceed opposite OB bottom
                        if tp3 > oppositeOBBottom
                            tp3 := oppositeOBBottom
                    else
                        tp1 := tpZoneStart - tp1Dist
                        tp2 := tpZoneStart - tp2Dist
                        tp3 := tpZoneStart - tp3Dist
                        // Clamp: TP3 should not go below opposite OB top (support)
                        if tp3 < oppositeOBTop
                            tp3 := oppositeOBTop
                else
                    // Fallback: use % of banca from entry price
                    float riskPerUnit = math.abs(entryPrice - stopLoss)
                    float tp1Reward = accountBalance * 1.0 / 100.0
                    float tp2Reward = accountBalance * 2.0 / 100.0
                    float tp3Reward = accountBalance * 3.0 / 100.0
                    float tp1DistF = tp1Reward / (positionSize * actualEntries)
                    float tp2DistF = tp2Reward / (positionSize * actualEntries)
                    float tp3DistF = tp3Reward / (positionSize * actualEntries)
                    tp1 := direction == "Long" ? entryPrice + tp1DistF : entryPrice - tp1DistF
                    tp2 := direction == "Long" ? entryPrice + tp2DistF : entryPrice - tp2DistF
                    tp3 := direction == "Long" ? entryPrice + tp3DistF : entryPrice - tp3DistF

                // --- Draw individual TP lines for this entry ---
                color tpLineColor = direction == "Long" ? takeProfitColor : shortLadderColor
                float tpRewardDisplay = accountBalance * (i + 1) / actualEntries * riskPerTradePct / 100.0
                line tp1Line = line.new(ladderStartX, tp1, ladderEndX, tp1, xloc = xloc.bar_time, color = color.new(tpLineColor, 30), style = line.style_solid, width = 1)
                array.push(ob.tpLines, tp1Line)
                string tp1Text = "TP1 E" + str.tostring(i + 1) + "\n" + str.tostring(tp1, format.mintick)
                label tp1Label = label.new(ladderEndX, tp1, tp1Text, xloc = xloc.bar_time, color = color.new(tpLineColor, 70), textcolor = ladderLabelColor, style = label.style_label_left, size = size.tiny)
                array.push(ob.tpLabels, tp1Label)

                line tp2Line = line.new(ladderStartX, tp2, ladderEndX, tp2, xloc = xloc.bar_time, color = color.new(tpLineColor, 50), style = line.style_solid, width = 1)
                array.push(ob.tpLines, tp2Line)
                string tp2Text = "TP2 E" + str.tostring(i + 1) + "\n" + str.tostring(tp2, format.mintick)
                label tp2Label = label.new(ladderEndX, tp2, tp2Text, xloc = xloc.bar_time, color = color.new(tpLineColor, 80), textcolor = ladderLabelColor, style = label.style_label_left, size = size.tiny)
                array.push(ob.tpLabels, tp2Label)

                line tp3Line = line.new(ladderStartX, tp3, ladderEndX, tp3, xloc = xloc.bar_time, color = color.new(tpLineColor, 30), style = line.style_solid, width = 1)
                array.push(ob.tpLines, tp3Line)
                string tp3Text = "TP3 E" + str.tostring(i + 1) + "\n" + str.tostring(tp3, format.mintick)
                label tp3Label = label.new(ladderEndX, tp3, tp3Text, xloc = xloc.bar_time, color = color.new(tpLineColor, 60), textcolor = ladderLabelColor, style = label.style_label_left, size = size.tiny)
                array.push(ob.tpLabels, tp3Label)

                // --- Re-entry control + Strategy execution ---
                bool alreadyFired = hasFired(entryId, firedEntries)

                if isPriced and not alreadyFired
                    array.push(firedEntries, entryId)

                    // Strategy execution (TradingView paper trading)
                    if enableStrategyOrders
                        string stratId = direction + "_E" + str.tostring(i + 1)
                        if direction == "Long"
                            strategy.entry(stratId, strategy.long, qty = positionSize, limit = entryPrice)
                            strategy.exit(stratId + "_SL", stratId, stop = stopLoss)
                            strategy.exit(stratId + "_TP1", stratId, limit = tp1, qty_percent = 33)
                            strategy.exit(stratId + "_TP2", stratId, limit = tp2, qty_percent = 33)
                            strategy.exit(stratId + "_TP3", stratId, limit = tp3)

                        if direction == "Short"
                            strategy.entry(stratId, strategy.short, qty = positionSize, limit = entryPrice)
                            strategy.exit(stratId + "_SL", stratId, stop = stopLoss)
                            strategy.exit(stratId + "_TP1", stratId, limit = tp1, qty_percent = 33)
                            strategy.exit(stratId + "_TP2", stratId, limit = tp2, qty_percent = 33)
                            strategy.exit(stratId + "_TP3", stratId, limit = tp3)

                    // Send webhook alert (deduplicated: fires once per entry)
                    sendWebhookAlert("entry", direction, entryPrice, positionSize, stopLoss, tp1, tp2, tp3, entryId)

            // Average entry price line + label (display only)
            line avgLine = line.new(ladderStartX, avgEntry, ladderEndX, avgEntry, xloc = xloc.bar_time, color = ladderColor, style = line.style_solid, width = 2)
            ob.avgPriceLine := avgLine
            string dirSymbol = direction == "Long" ? "LONG" : "SHORT"
            string avgText = "AVG ENTRY (" + dirSymbol + ")\n" + str.tostring(avgEntry, format.mintick) + "\nSize: " + str.tostring(positionSize * actualEntries, "#.###") + " units\nSL Risk: " + str.tostring(riskAmount, "#.##") + " USDT"
            ob.avgPriceLabel := label.new(ladderStartX, avgEntry, avgText, xloc = xloc.bar_time, color = color.new(ladderColor, 40), textcolor = ladderLabelColor, style = label.style_label_right, size = size.small)

            // SL line + label
            line slLine = line.new(ladderStartX, stopLoss, ladderEndX, stopLoss, xloc = xloc.bar_time, color = stopLossColor, style = line.style_dashed, width = 1)
            array.push(ob.slLines, slLine)
            string slText = "SL\n" + str.tostring(stopLoss, format.mintick) + "\n-" + str.tostring(riskAmount, "#.##") + " USDT"
            label slLabel = label.new(ladderEndX, stopLoss, slText, xloc = xloc.bar_time, color = color.new(stopLossColor, 60), textcolor = ladderLabelColor, style = label.style_label_left, size = size.tiny)
            array.push(ob.slLabels, slLabel)

// ============================================================================
// 50% LINE + VALUE ZONE VISUALIZATION (inside each OB)
// ============================================================================
render50LineAndValueZone(orderBlock ob) =>
    info = ob.info
    float obTop = info.top
    float obBottom = info.bottom
    float mid50 = (obTop + obBottom) / 2.0

    info.swing50 := mid50
    info.swingHigh := obTop
    info.swingLow := obBottom

    int zoneSize = int(extendZonesDynamic ? na(info.breakTime) ? extendZonesByTime : (info.breakTime - info.startTime) : extendZonesByTime)
    int endX = int(na(info.breakTime) ? (time + 1) : info.breakTime)

    if show50Line
        ob.line50 := line.new(info.startTime, mid50, endX, mid50, xloc = xloc.bar_time, color = line50Color, style = lineStyleFromString(line50Style), width = line50Width)

    if showValueZones
        zoneColor = info.obType == "Bull" ? buyZoneColor : sellZoneColor
        float zoneTop = info.obType == "Bull" ? mid50 : obTop
        float zoneBottom = info.obType == "Bull" ? obBottom : mid50
        ob.valueZone := box.new(info.startTime, zoneTop, endX, zoneBottom, xloc = xloc.bar_time, bgcolor = color.new(zoneColor, valueZoneTransp), border_color = color.new(zoneColor, 80), border_width = 1)

// ============================================================================
// RENDER ORDER BLOCK
// ============================================================================
renderOrderBlock(orderBlock ob, bool isNearest, float midRangePrice, float oppositeOBTop, float oppositeOBBottom) =>
    orderBlockInfo info = ob.info
    ob.isRendered := true
    orderColor = info.obType == "Bull" ? bullOrderBlockColor : bearOrderBlockColor

    if OBsEnabled and not (not showInvalidated and info.breaker)
        ob.orderBox := createOBBox(orderColor, 1.5)
        if info.combined
            ob.orderBox.set_bgcolor(colorWithTransparency(orderColor, 1.1))
        ob.orderBoxText := createOBBox(color.new(color.white, 100))
        if orderBlockVolumetricInfo
            ob.orderBoxPositive := createOBBox(bullOrderBlockColor)
            ob.orderBoxNegative := createOBBox(bearOrderBlockColor)
            ob.orderSeperator := line.new(na,na,na,na,xloc.bar_time,extend.none,textColor,line.style_dashed,1)
            ob.orderTextSeperator := line.new(na,na,na,na,xloc.bar_time,extend.none,textColor,line.style_solid,1)

        zoneSize = extendZonesDynamic ? na(info.breakTime) ? extendZonesByTime : (info.breakTime - info.startTime) : extendZonesByTime
        if na(info.breakTime)
            zoneSize := (time + 1) - info.startTime

        startX = volumeBarsLeftSide ? info.startTime : info.startTime + zoneSize - zoneSize / 3
        maxEndX = volumeBarsLeftSide ? info.startTime + zoneSize / 3 : info.startTime + zoneSize

        moveBox(ob.orderBox, info.startTime, info.top, info.startTime + zoneSize, info.bottom)
        moveBox(ob.orderBoxText, volumeBarsLeftSide ? maxEndX : info.startTime, info.top, volumeBarsLeftSide ? info.startTime + zoneSize : startX, info.bottom)

        percentage = int((math.min(info.obHighVolume, info.obLowVolume) / math.max(info.obHighVolume, info.obLowVolume)) * 100.0)
        OBText = (na(info.combinedTimeframesStr) ? formatTimeframeString(info.timeframeStr) : info.combinedTimeframesStr) + " OB"
        box.set_text(ob.orderBoxText, (orderBlockVolumetricInfo ? str.tostring(info.obVolume, format.volume) + " (" + str.tostring(percentage) + "%)\n" : "") + (info.combined ? "[Combined]\n" : "") + OBText)

        if orderBlockVolumetricInfo
            curEndXHigh = int(math.ceil((info.obHighVolume / info.obVolume) * (maxEndX - startX) + startX))
            curEndXLow = int(math.ceil((info.obLowVolume / info.obVolume) * (maxEndX - startX) + startX))
            moveBox(ob.orderBoxPositive, mirrorVolumeBars ? startX : curEndXLow, info.top, mirrorVolumeBars ? curEndXHigh : maxEndX, (info.bottom + info.top) / 2)
            moveBox(ob.orderBoxNegative, mirrorVolumeBars ? startX : curEndXHigh, info.bottom, mirrorVolumeBars ? curEndXLow : maxEndX, (info.bottom + info.top) / 2)
            moveLine(ob.orderSeperator, volumeBarsLeftSide ? startX : maxEndX, (info.bottom + info.top) / 2, volumeBarsLeftSide ? maxEndX : startX)
            line.set_xy1(ob.orderTextSeperator, volumeBarsLeftSide ? maxEndX : startX, info.top)
            line.set_xy2(ob.orderTextSeperator, volumeBarsLeftSide ? maxEndX : startX, info.bottom)

        render50LineAndValueZone(ob)

        if showLadder and not info.breaker and isNearest
            renderLadderForOB(ob, isNearest, midRangePrice, oppositeOBTop, oppositeOBBottom)

// ============================================================================
// OB SWING DETECTION
// ============================================================================
findOBSwings(len) =>
    var swingType = 0
    var obSwing top = obSwing.new(na, na)
    var obSwing bottom = obSwing.new(na, na)

    upper = ta.highest(len)
    lower = ta.lowest(len)

    swingType := high[len] > upper ? 0 : low[len] < lower ? 1 : swingType

    if swingType == 0 and swingType[1] != 0
        top := obSwing.new(bar_index[len], high[len], volume[len])

    if swingType == 1 and swingType[1] != 1
        bottom := obSwing.new(bar_index[len], low[len], volume[len])

    [top, bottom]

// ============================================================================
// FIND ORDER BLOCKS
// ============================================================================
findOrderBlocks() =>
    [top, btm] = findOBSwings(swingLength)
    if bar_index > last_bar_index - maxDistanceToLastBar
        useBody = false
        max = useBody ? math.max(close, open) : high
        min = useBody ? math.min(close, open) : low

        if bullishOrderBlocksList.size() > 0
            for i = bullishOrderBlocksList.size() - 1 to 0
                currentOB = bullishOrderBlocksList.get(i)
                if not currentOB.breaker
                    if (obEndMethod == "Wick" ? low : math.min(open, close)) < currentOB.bottom
                        currentOB.breaker := true
                        currentOB.breakTime := time
                        currentOB.bbVolume := volume
                else
                    if high > currentOB.top
                        bullishOrderBlocksList.remove(i)

        if close > top.y and not top.crossed
            top.crossed := true

            boxBtm = max[1]
            boxTop = min[1]
            boxLoc = time[1]

            for i = 1 to (bar_index - top.x) - 1
                boxBtm := math.min(min[i], boxBtm)
                boxTop := boxBtm == min[i] ? max[i] : boxTop
                boxLoc := boxBtm == min[i] ? time[i] : boxLoc

            newOrderBlockInfo = orderBlockInfo.new(boxTop, boxBtm, volume + volume[1] + volume[2], "Bull", boxLoc)
            newOrderBlockInfo.obLowVolume := volume[2]
            newOrderBlockInfo.obHighVolume := volume + volume[1]

            obSize = math.abs(newOrderBlockInfo.top - newOrderBlockInfo.bottom)
            if obSize <= atr * maxATRMult
                bullishOrderBlocksList.unshift(newOrderBlockInfo)
                if bullishOrderBlocksList.size() > maxOrderBlocks
                    bullishOrderBlocksList.pop()

        if bearishOrderBlocksList.size() > 0
            for i = bearishOrderBlocksList.size() - 1 to 0
                currentOB = bearishOrderBlocksList.get(i)
                if not currentOB.breaker
                    if (obEndMethod == "Wick" ? high : math.max(open, close)) > currentOB.top
                        currentOB.breaker := true
                        currentOB.breakTime := time
                        currentOB.bbVolume := volume
                else
                    if low < currentOB.bottom
                        bearishOrderBlocksList.remove(i)

        if close < btm.y and not btm.crossed
            btm.crossed := true

            boxBtm = min[1]
            boxTop = max[1]
            boxLoc = time[1]

            for i = 1 to (bar_index - btm.x) - 1
                boxTop := math.max(max[i], boxTop)
                boxBtm := boxTop == max[i] ? min[i] : boxBtm
                boxLoc := boxTop == max[i] ? time[i] : boxLoc

            newOrderBlockInfo = orderBlockInfo.new(boxTop, boxBtm, volume + volume[1] + volume[2], "Bear", boxLoc)
            newOrderBlockInfo.obLowVolume := volume + volume[1]
            newOrderBlockInfo.obHighVolume := volume[2]

            obSize = math.abs(newOrderBlockInfo.top - newOrderBlockInfo.bottom)
            if obSize <= atr * maxATRMult
                bearishOrderBlocksList.unshift(newOrderBlockInfo)
                if bearishOrderBlocksList.size() > maxOrderBlocks
                    bearishOrderBlocksList.pop()
    true

// ============================================================================
// COMBINE OBS
// ============================================================================
areaOfOB(orderBlockInfo OBInfoF) =>
    float XA1 = OBInfoF.startTime
    float XA2 = na(OBInfoF.breakTime) ? time + 1 : OBInfoF.breakTime
    float YA1 = OBInfoF.top
    float YA2 = OBInfoF.bottom
    float edge1 = math.sqrt((XA2 - XA1) * (XA2 - XA1) + (YA2 - YA2) * (YA2 - YA2))
    float edge2 = math.sqrt((XA2 - XA2) * (XA2 - XA2) + (YA2 - YA1) * (YA2 - YA1))
    float totalArea = edge1 * edge2
    totalArea

doOBsTouch(orderBlockInfo OBInfo1, orderBlockInfo OBInfo2) =>
    float XA1 = OBInfo1.startTime
    float XA2 = na(OBInfo1.breakTime) ? time + 1 : OBInfo1.breakTime
    float YA1 = OBInfo1.top
    float YA2 = OBInfo1.bottom
    float XB1 = OBInfo2.startTime
    float XB2 = na(OBInfo2.breakTime) ? time + 1 : OBInfo2.breakTime
    float YB1 = OBInfo2.top
    float YB2 = OBInfo2.bottom
    float intersectionArea = math.max(0, math.min(XA2, XB2) - math.max(XA1, XB1)) * math.max(0, math.min(YA1, YB1) - math.max(YA2, YB2))
    float unionArea = areaOfOB(OBInfo1) + areaOfOB(OBInfo2) - intersectionArea
    float overlapPercentage = (intersectionArea / unionArea) * 100.0
    overlapPercentage > overlapThresholdPercentage

isOBValid(orderBlockInfo OBInfo) =>
    valid = true
    if OBInfo.disabled
        valid := false
    valid

combineOBsFunc() =>
    if allOrderBlocksList.size() > 0
        lastCombinations = 999
        while lastCombinations > 0
            lastCombinations := 0
            for i = 0 to allOrderBlocksList.size() - 1
                curOB1 = allOrderBlocksList.get(i)
                for j = 0 to allOrderBlocksList.size() - 1
                    curOB2 = allOrderBlocksList.get(j)
                    if i == j
                        continue
                    if not isOBValid(curOB1.info) or not isOBValid(curOB2.info)
                        continue
                    if curOB1.info.obType != curOB2.info.obType
                        continue
                    if doOBsTouch(curOB1.info, curOB2.info)
                        curOB1.info.disabled := true
                        curOB2.info.disabled := true
                        orderBlock newOB = createOrderBlock(orderBlockInfo.new(math.max(curOB1.info.top, curOB2.info.top), math.min(curOB1.info.bottom, curOB2.info.bottom), curOB1.info.obVolume + curOB2.info.obVolume, curOB1.info.obType))
                        newOB.info.startTime := math.min(curOB1.info.startTime, curOB2.info.startTime)
                        newOB.info.breakTime := math.max(nz(curOB1.info.breakTime), nz(curOB2.info.breakTime))
                        newOB.info.breakTime := newOB.info.breakTime == 0 ? na : newOB.info.breakTime
                        newOB.info.timeframeStr := curOB1.info.timeframeStr
                        newOB.info.obVolume := curOB1.info.obVolume + curOB2.info.obVolume
                        newOB.info.obLowVolume := curOB1.info.obLowVolume + curOB2.info.obLowVolume
                        newOB.info.obHighVolume := curOB1.info.obHighVolume + curOB2.info.obHighVolume
                        newOB.info.bbVolume := nz(curOB1.info.bbVolume, 0) + nz(curOB2.info.bbVolume, 0)
                        newOB.info.breaker := curOB1.info.breaker or curOB2.info.breaker
                        newOB.info.combined := true
                        if timeframe.in_seconds(curOB1.info.timeframeStr) != timeframe.in_seconds(curOB2.info.timeframeStr)
                            newOB.info.combinedTimeframesStr := (na(curOB1.info.combinedTimeframesStr) ? formatTimeframeString(curOB1.info.timeframeStr) : curOB1.info.combinedTimeframesStr) + " & " + (na(curOB2.info.combinedTimeframesStr) ? formatTimeframeString(curOB2.info.timeframeStr) : curOB2.info.combinedTimeframesStr)
                        allOrderBlocksList.unshift(newOB)
                        lastCombinations += 1

// ============================================================================
// TIMEFRAME DATA REQUEST
// ============================================================================
reqSeq(timeframeStr) =>
    [bullishOrderBlocksListF, bearishOrderBlocksListF] = request.security(syminfo.tickerid, timeframeStr, [bullishOrderBlocksList, bearishOrderBlocksList])
    [bullishOrderBlocksListF, bearishOrderBlocksListF]

getTFData(timeframeInfo timeframeInfoF, timeframeStr) =>
    if not isTimeframeLower(timeframeInfoF.timeframeStr, timeframe.period) and timeframeInfoF.isEnabled
        [bullishOrderBlocksListF, bearishOrderBlocksListF] = reqSeq(timeframeStr)
        [bullishOrderBlocksListF, bearishOrderBlocksListF]
    else
        [na, na]

handleTimeframeInfo(timeframeInfo timeframeInfoF, bullishOrderBlocksListF, bearishOrderBlocksListF) =>
    if not isTimeframeLower(timeframeInfoF.timeframeStr, timeframe.period) and timeframeInfoF.isEnabled
        timeframeInfoF.bullishOrderBlocksList := bullishOrderBlocksListF
        timeframeInfoF.bearishOrderBlocksList := bearishOrderBlocksListF

// ============================================================================
// CALCULATE MID-RANGE PRICE (between nearest Bull OB and Bear OB)
// ============================================================================
calcMidRange(float bullOBTop, float bullOBBottom, float bearOBTop, float bearOBBottom) =>
    float lowRef = na(bullOBBottom) ? na : bullOBTop
    float highRef = na(bearOBBottom) ? na : bearOBBottom
    float mid = na
    if not na(lowRef) and not na(highRef) and highRef > lowRef
        mid := (lowRef + highRef) / 2.0
    mid

// ============================================================================
// FINAL ORDER BLOCK HANDLING
// Returns: [midPrice, nearestBullStart, nearestBearStart, bullOBTop, bullOBBottom, bearOBTop, bearOBBottom]
// so the caller (global scope) can update global drawing variables
// ============================================================================
handleOrderBlocksFinal() =>
    if allOrderBlocksList.size() > 0
        for i = 0 to allOrderBlocksList.size() - 1
            safeDeleteOrderBlock(allOrderBlocksList.get(i))
    allOrderBlocksList.clear()

    for i = 0 to timeframeInfos.size() - 1
        curTimeframe = timeframeInfos.get(i)
        if not curTimeframe.isEnabled
            continue
        if not na(curTimeframe.bullishOrderBlocksList) and curTimeframe.bullishOrderBlocksList.size() > 0
            for j = 0 to math.min(curTimeframe.bullishOrderBlocksList.size() - 1, bullishOrderBlocks - 1)
                orderBlockInfoF = curTimeframe.bullishOrderBlocksList.get(j)
                orderBlockInfoF.timeframeStr := curTimeframe.timeframeStr
                allOrderBlocksList.unshift(createOrderBlock(orderBlockInfo.copy(orderBlockInfoF)))

        if not na(curTimeframe.bearishOrderBlocksList) and curTimeframe.bearishOrderBlocksList.size() > 0
            for j = 0 to math.min(curTimeframe.bearishOrderBlocksList.size() - 1, bearishOrderBlocks - 1)
                orderBlockInfoF = curTimeframe.bearishOrderBlocksList.get(j)
                orderBlockInfoF.timeframeStr := curTimeframe.timeframeStr
                allOrderBlocksList.unshift(createOrderBlock(orderBlockInfo.copy(orderBlockInfoF)))

    if combineOBs
        combineOBsFunc()

    // Find nearest bullish OB (support) and nearest bearish OB (resistance)
    float currentPrice = close
    float nearestBullDist = 999999999.0
    float nearestBearDist = 999999999.0
    int nearestBullIdx = -1
    int nearestBearIdx = -1

    if allOrderBlocksList.size() > 0
        for i = 0 to allOrderBlocksList.size() - 1
            curOB = allOrderBlocksList.get(i)
            if not isOBValid(curOB.info)
                continue
            if curOB.info.breaker
                continue
            float obMid = (curOB.info.top + curOB.info.bottom) / 2.0
            float dist = math.abs(currentPrice - obMid)
            float curOBRange = math.abs(curOB.info.top - curOB.info.bottom)
            if curOB.info.obType == "Bull"
                // Allow price to be above, inside, or slightly below the OB
                // This ensures entries are repositioned on the next support OB after a stop
                float bullProximityLimit = curOB.info.bottom - curOBRange * 2.0
                if currentPrice >= bullProximityLimit and dist < nearestBullDist
                    nearestBullDist := dist
                    nearestBullIdx := i
            else if curOB.info.obType == "Bear"
                // Allow price to be below, inside, or slightly above the OB
                // This ensures entries are repositioned on the next resistance OB after a stop
                float bearProximityLimit = curOB.info.top + curOBRange * 2.0
                if currentPrice <= bearProximityLimit and dist < nearestBearDist
                    nearestBearDist := dist
                    nearestBearIdx := i

    // Get OB info for mid-range and opposite OB references
    float bullOBTop = na
    float bullOBBottom = na
    float bearOBTop = na
    float bearOBBottom = na
    int nearestBullStart = na
    int nearestBearStart = na

    if nearestBullIdx >= 0
        bullOBTop := allOrderBlocksList.get(nearestBullIdx).info.top
        bullOBBottom := allOrderBlocksList.get(nearestBullIdx).info.bottom
        nearestBullStart := allOrderBlocksList.get(nearestBullIdx).info.startTime

    if nearestBearIdx >= 0
        bearOBTop := allOrderBlocksList.get(nearestBearIdx).info.top
        bearOBBottom := allOrderBlocksList.get(nearestBearIdx).info.bottom
        nearestBearStart := allOrderBlocksList.get(nearestBearIdx).info.startTime

    // Calculate mid-range price between the two nearest OBs
    float midPrice = calcMidRange(bullOBTop, bullOBBottom, bearOBTop, bearOBBottom)

    // Render all OBs, with ladders only on the 2 nearest
    if allOrderBlocksList.size() > 0
        for i = 0 to allOrderBlocksList.size() - 1
            curOB = allOrderBlocksList.get(i)
            if isOBValid(curOB.info)
                bool isNearest = (i == nearestBullIdx or i == nearestBearIdx)
                float oppTop = na
                float oppBottom = na
                if curOB.info.obType == "Bull"
                    oppTop := bearOBTop
                    oppBottom := bearOBBottom
                else
                    oppTop := bullOBTop
                    oppBottom := bullOBBottom
                renderOrderBlock(curOB, isNearest, midPrice, oppTop, oppBottom)

    [midPrice, nearestBullStart, nearestBearStart, bullOBTop, bullOBBottom, bearOBTop, bearOBBottom]

// ============================================================================
// MAIN EXECUTION
// ============================================================================
findOrderBlocks()

[bullishOrderBlocksListTimeframe1, bearishOrderBlocksTimeframe1] = getTFData(timeframeInfos.get(0), timeframe1)

if barstate.isconfirmed
    handleTimeframeInfo(timeframeInfos.get(0), bullishOrderBlocksListTimeframe1, bearishOrderBlocksTimeframe1)
    [midPrice, nearestBullStart, nearestBearStart, bullOBTop, bullOBBottom, bearOBTop, bearOBBottom] = handleOrderBlocksFinal()
    currentMidRange := midPrice

    // Re-entry control: clear fired entries when a new OB replaces the old one
    if not na(nearestBullStart)
        if na(lastBullOBStartTime) or nearestBullStart != lastBullOBStartTime
            clearFiredByDirection("Long", firedEntries)
            lastBullOBStartTime := nearestBullStart

    if not na(nearestBearStart)
        if na(lastBearOBStartTime) or nearestBearStart != lastBearOBStartTime
            clearFiredByDirection("Short", firedEntries)
            lastBearOBStartTime := nearestBearStart

    // Draw mid-range line (global scope)
    if showMidRange and not na(midPrice)
        int endX = int(time + 1)
        int startX = int(time + 1) - extendZonesByTime * 2
        line.delete(midRangeLine)
        midRangeLine := line.new(startX, midPrice, endX, midPrice, xloc = xloc.bar_time, color = midRangeColor, style = lineStyleFromString(midRangeStyle), width = midRangeWidth)
        label.delete(midRangeLabel)
        string midText = "MID-RANGE\n" + str.tostring(midPrice, format.mintick)
        midRangeLabel := label.new(endX, midPrice, midText, xloc = xloc.bar_time, color = color.new(midRangeColor, 50), textcolor = textColor, style = label.style_label_left, size = size.tiny)
    else
        line.delete(midRangeLine)
        label.delete(midRangeLabel)
